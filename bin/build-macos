#!/usr/bin/env bash
set -euo pipefail
project_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
output_directory="$project_directory/build"
cd "$project_directory"
npm ci --no-audit --no-fund
npm run build
application_version="$(node -p 'JSON.parse(require("fs").readFileSync("package.json", "utf8")).version')"
cd backend
../node_modules/.bin/tauri build --ci --features desktop --bundles app,dmg -- --locked
mkdir -p "$output_directory"
matched=false
for bundle_file in "$output_directory/.cache/release/bundle/dmg/"*"$application_version"*.dmg; do
  [[ -f "$bundle_file" ]] || continue
  output_file="$output_directory/$(basename -- "$bundle_file")"
  cp -f -- "$bundle_file" "$output_file"
  matched=true
  printf 'Built: %s\n' "$output_file"
done
if [[ "$matched" == false ]]; then
  printf 'No dmg artifact was generated for version %s\n' "$application_version" >&2
  exit 1
fi
